{
  "id": "hault.knowledge-graph",
  "name": "Knowledge Graph",
  "version": "0.1.0",
  "description": "Auto-linked concept graph from your notes.",
  "author": "HAULT Core",
  "entry": "dist/index.js",
  "permissions": [
    {
      "action": "storage.read",
      "scope": "namespace:notes/*",
      "reason": "Read notes"
    }
  ],
  "ui": {
    "routes": [
      {
        "path": "/graph",
        "title": "Knowledge Graph",
        "icon": "network"
      }
    ]
  }
}
