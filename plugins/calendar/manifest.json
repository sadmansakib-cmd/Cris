{
  "id": "hault.calendar",
  "name": "Calendar",
  "version": "0.1.0",
  "description": "CalDAV + local calendar with reminders.",
  "author": "HAULT Core",
  "entry": "dist/index.js",
  "permissions": [
    {
      "action": "storage.write",
      "scope": "namespace:calendar/*",
      "reason": "Store events"
    }
  ],
  "ui": {
    "routes": [
      {
        "path": "/calendar",
        "title": "Calendar",
        "icon": "calendar"
      }
    ]
  }
}
