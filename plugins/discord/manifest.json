{
  "id": "hault.discord",
  "name": "Discord",
  "version": "0.1.0",
  "description": "Bot + webhook integration.",
  "author": "HAULT Core",
  "entry": "dist/index.js",
  "permissions": [
    {
      "action": "secret.read",
