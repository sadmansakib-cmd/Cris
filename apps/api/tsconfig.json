{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "prisma", "test"],
  "exclude": ["node_modules", "dist"]
}
