# Environment
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PORT=3000
TRUST_PROXY=1
APP_VERSION=0.1.0
ENABLE_SWAGGER=true

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hault
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_32_character_long_secret_string
ENCRYPTION_KEY=replace_with_32_byte_base64_string_for_encryption==
JWT_ACCESS_TTL=600
JWT_REFRESH_TTL=2592000

# Seeding
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin

# AI Providers
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
OLLAMA_BASE_URL=http://localhost:11434

# Storage
STORAGE_DEFAULT_PROVIDER=local
STORAGE_LOCAL_ROOT=./var/files
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Email
EMAIL_DEFAULT_PROVIDER=smtp
EMAIL_FROM=HAULT <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# WebAuthn
WEBAUTHN_RP_ID=localhost

# Media Providers
STT_DEFAULT_PROVIDER=openai
TTS_DEFAULT_PROVIDER=openai
OCR_DEFAULT_PROVIDER=tesseract
VISION_DEFAULT_PROVIDER=ai-vision
