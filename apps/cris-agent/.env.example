# ==============================================================================
# Cris Agent - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or credentials to Git!
# ==============================================================================

# Mode selection: 'pipeline' (recommended default), 'text', or 'live'
CRIS_MODE=pipeline

# ------------------------------------------------------------------------------
# LLM Providers & Models
# ------------------------------------------------------------------------------
PRIMARY_PROVIDER=gemini
PROVIDER_FALLBACK_CHAIN=gemini,groq,ollama

# Google Gemini API (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API Fallback (Optional, get key from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Fallback (Optional, run locally via https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Free-Tier Rate Limits
GEMINI_RPM=15
GEMINI_RPD=1500
RETRY_MAX_ATTEMPTS=4
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=16.0

# ------------------------------------------------------------------------------
# Voice Subsystem Settings
# ------------------------------------------------------------------------------
CRIS_WAKE_WORD=Hey Cris
CRIS_SILENCE_TIMEOUT=20
CRIS_WHISPER_MODEL=base
CRIS_TTS_VOICE_EN=en-US-GuyNeural
CRIS_TTS_VOICE_BN=bn-BD-PradeepNeural
# Optional explicit audio device indexes (leave blank for Windows default)
# CRIS_INPUT_DEVICE_INDEX=1
# CRIS_OUTPUT_DEVICE_INDEX=3

# ------------------------------------------------------------------------------
# Security & Safety Boundaries
# ------------------------------------------------------------------------------
# Semicolon-separated folder roots that file tools and app-builder can operate inside
ALLOWED_ROOTS=d:\halt;C:\Users\ramin\Projects
# Semicolon-separated application executables allowed for open_app
APP_ALLOWLIST=notepad.exe;calc.exe;code.cmd;chrome.exe;explorer.exe;msedge.exe;mspaint.exe;cmd.exe;powershell.exe

# Emergency kill switch hotkey (instantly aborts automation)
KILL_SWITCH_HOTKEY=ctrl+alt+q
CONFIRMATION_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username
