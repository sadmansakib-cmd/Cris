{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAULT",
  "version": "0.1.0",
  "identifier": "app.hault.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @hault/web dev",
    "beforeBuildCommand": "pnpm --filter @hault/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HAULT",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "HAULT — private AI OS",
    "longDescription": "HAULT desktop shell that hosts the HAULT web UI and exposes native capabilities to the Computer Control plugin."
  }
}
