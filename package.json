{
  "name": "hault",
  "private": true,
  "version": "0.0.0",
  "description": "HAULT — self-hosted modular AI operating system",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:dev": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "pnpm --filter @hault/api prisma:generate",
    "prisma:migrate": "pnpm --filter @hault/api prisma:migrate",
    "prisma:seed": "pnpm --filter @hault/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
