# Core API
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Security & JWT
JWT_SECRET=your_secure_random_string
ENCRYPTION_KEY=your_32_byte_hex_string

# Database
# Note: Use pooler session port (5432) for prisma migrate deploy, and transaction port (6543) for app runtime.
DATABASE_URL=postgresql://[user]:[password]@[pooler-host]:5432/postgres

# AI Providers
GEMINI_API_KEY=your_gemini_api_key

# OAuth Providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage (Supabase S3)
S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET=hault
